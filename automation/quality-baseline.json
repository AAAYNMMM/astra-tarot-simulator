{
  "schemaVersion": 1,
  "task": "MOD-006A",
  "manualFileLimits": {
    "javascript": 600,
    "css": 900,
    "entryJavascriptRecommended": 200
  },
  "scan": {
    "extensions": [
      ".js",
      ".mjs",
      ".cjs",
      ".css"
    ],
    "excludedDirectories": [
      ".git",
      ".github",
      "assets",
      "node_modules",
      "src/generated"
    ]
  },
  "knownDebt": [],
  "policy": {
    "knownDebtAtOrBelowBaseline": "WARN",
    "knownDebtGrowth": "FAIL",
    "newUnregisteredOverLimitFile": "FAIL",
    "expiredDebtStillOverLimit": "FAIL",
    "resolvedDebtReintroduced": "FAIL",
    "fullScopeRequiresNoOverLimitManualFiles": true
  },
  "resolvedDebt": [
    {
      "path": "app.js",
      "kind": "javascript",
      "resolvedByTask": "MOD-006A",
      "replacement": "src/app/application.js"
    },
    {
      "path": "data.js",
      "kind": "javascript",
      "resolvedByTask": "MOD-006A",
      "replacement": "src/knowledge/legacy/index.js"
    },
    {
      "path": "src/app/legacy-runtime.js",
      "kind": "javascript",
      "resolvedByTask": "MOD-006A",
      "replacement": "src/app/application.js"
    },
    {
      "path": "styles.css",
      "kind": "css",
      "resolvedByTask": "MOD-002",
      "replacement": "src/styles/index.css"
    }
  ]
}
