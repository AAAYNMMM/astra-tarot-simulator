{
  "$id": "https://astra.local/schemas/evaluation-case/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cardId": {
      "pattern": "^(?:major-(?:0|[1-9]|1[0-9]|2[01])|(?:wands|cups|swords|pentacles)-(?:ace|two|three|four|five|six|seven|eight|nine|ten|page|knight|queen|king))$",
      "type": "string"
    },
    "disallowedClaims": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^dev-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "orientation": {
      "enum": [
        "upright",
        "reversed"
      ]
    },
    "questionId": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "requiredEvidenceRoles": {
      "items": {
        "enum": [
          "state",
          "cause",
          "motivation",
          "obstacle",
          "opportunity",
          "resource",
          "relationship",
          "action",
          "boundary",
          "trend",
          "outcome",
          "reflection"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "spreadId": {
      "enum": [
        "single",
        "timeline",
        "cross",
        "celtic"
      ]
    },
    "targetDimensions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "questionId",
    "spreadId",
    "cardId",
    "orientation",
    "targetDimensions",
    "requiredEvidenceRoles",
    "disallowedClaims"
  ],
  "type": "object"
}
